#
# Taylor-Couette flow, Re = 100: the coarse cake grid of 16 x 128 cells,
# globally refined 1 time(s) (32 cells across the gap, 256 around).

[Grid]
Radial0 = 1.0 2.0 # [m]
Angular1 = 0.0 360.0 # [deg]
Cells0 = 16
Cells1 = 128
Refinement = 1

[Problem]
Name = taylorcouette_32x256
Omega1 = 100.0 # [rad/s]
Omega2 = 0.0 # [rad/s]
EnableGravity = false
EnableInertiaTerms = true

[Flux]
UpwindWeight = 0.5

[Component]
LiquidDensity = 1.0 # [kg/m^3]
LiquidDynamicViscosity = 1.0 # [Pa*s]
